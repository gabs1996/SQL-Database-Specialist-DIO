RESPONDENDO PRIMEIRA PERGUNTA SOBRE O DESAFIO:


WITH TAB_A AS(
SELECT 
ID_CLIENTE,
ROW_NUMBER() OVER(PARTITION BY ID_CLIENTE ORDER BY ID_CLIENTE) AS CONT_PED
FROM TAB_VENDAS
)

SELECT ID_CLIENTE, MAX(CONT_PED) FROM  TAB_A GROUP BY ID_CLIENTE


RESPONDENDO SEGUNDA PERGUNTA SOBRE O DESAFIO:



WITH TAB_A AS (
SELECT 
DISTINCT
NUM_FUNCIONARIO
FROM TAB_VENDAS
),

TAB_B AS (
SELECT 
DISTINCT
NM_TRANSPOR
FROM TAB_VENDAS
)

SELECT * FROM TAB_A AS TBA 
INNER JOIN TAB_B AS TBB
ON TBA.NM_CLI = TBB.NM_TRANSPOR

RESPONDENDO TERCEIRA PERGUNTA DO DESAFIO

SELECT
NM_TRANSPOR,
SUM(QTD_VEND) AS QTD_VENDIDA
FROM TAB_VENDAS
GROUP BY NM_TRANSPOR

RESPONDENDO QUARTA PERGUNTA:

SELECT DISTINCT
NM_PRODUTO,
NM_TRANSPOR
FROM TAB_VENDAS
ORDER BY 2  DESC



